{
  "name": "relay-handover",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm start",
    "build": "tsc -b && vite build",
    "test": "node --test server/rules.test.js server/reconstruction.test.js server/chat.test.js server/tenant.test.js server/accuracy.test.js server/health.test.js",
    "test:e2e": "npm run build && playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env scripts/serve.js",
    "migrate": "node --env-file-if-exists=.env scripts/database.js migrate",
    "seed": "node --env-file-if-exists=.env scripts/database.js seed"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "embedded-postgres": "^18.6.0-beta.19",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.1.0"
  }
}
